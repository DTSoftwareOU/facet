    <string name="pcsettings_intro">உங்கள் PC-இல் Facet for Windows இயங்கும்போது, இங்குள்ள அரட்டைகள் அதிலுள்ள ஒரு ஃபோல்டரில் கட்டளைகளை இயக்கலாம், ஃபைல்களைத் திருத்தலாம், Claude Code, Codex அமர்வுகளைத் தொடரலாம். உங்கள் சாதனங்களுக்கு இடையிலான மெசேஜ்கள் எண்ட்-டு-எண்ட் என்க்ரிப்ட் செய்யப்படுகின்றன.</string>
    <string name="pcsettings_online_now">இப்போது ஆன்லைனில்</string>
    <string name="pcsettings_sign_in">உங்கள் PC-ஐப் பயன்படுத்த உள்நுழையவும்</string>
    <string name="pcsettings_sign_in_subtitle">உங்கள் PC-க்கும் இந்தச் சாதனத்துக்கும் ஒரே Facet கணக்கு தேவை.</string>
    <string name="pcsettings_none_online">எந்த PC-யும் ஆன்லைனில் இல்லை</string>
    <string name="pcsettings_none_online_subtitle">உங்கள் PC-இல் Facet-ஐத் திறந்து இந்தக் கணக்கில் உள்நுழையவும்.</string>
    <string name="pcsettings_ready">தயார்</string>
    <string name="pcsettings_ask_before">எப்போது கேட்க வேண்டும்</string>
    <string name="pcsettings_yolo_on">YOLO பயன்முறை ஆன் செய்யப்பட்டுள்ளதால், உங்கள் PC-இல் செயல்கள் கேட்காமலே இயங்கும். இதைப் பயன்படுத்த, அமைப்புகளில் அதை ஆஃப் செய்யவும்.</string>
    <string name="pcsettings_how_to_pick">ஓர் அரட்டைக்கு PC-ஐயும் ஃபோல்டரையும் தேர்ந்தெடுக்க, மெசேஜ் பெட்டிக்கு மேலே உள்ள PC சிப்பைத் தட்டவும், அல்லது /pc என டைப் செய்யவும்.</string>
