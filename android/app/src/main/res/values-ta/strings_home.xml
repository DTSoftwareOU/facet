    <string name="auth_confirm_new_password">புதிய கடவுச்சொல்லை உறுதிப்படுத்தவும்</string>
    <string name="auth_reset_password">கடவுச்சொல்லை மீட்டமை</string>
    <string name="auth_no_email">இந்த ஒத்திசைவு சர்வரால் மின்னஞ்சல் அனுப்ப முடியாது. அதற்குப் பதிலாக உங்கள் மீட்புக் குறியீட்டைப் பயன்படுத்தவும் அல்லது சர்வர் நிர்வாகியிடம் கேட்கவும்.</string>
    <string name="auth_email_reset_warning">மீட்புக் குறியீடு இல்லாமல், சர்வரில் உள்ள என்க்ரிப்ட் செய்யப்பட்ட உங்கள் தரவைத் திறக்க முடியாது, எனவே அது நீக்கப்படும். பிறகு இந்தச் சாதனத்தில் உள்ள அரட்டைகள் மீண்டும் பதிவேற்றப்படும்.</string>
    <string name="auth_email_me_code">குறியீட்டை மின்னஞ்சலில் அனுப்பு</string>
    <string name="auth_email_code_sent">%1$s முகவரிக்கு ஒரு கணக்கு இருந்தால், 8 இலக்கக் குறியீட்டை அனுப்பியுள்ளோம். அது 30 நிமிடங்களில் காலாவதியாகும்.</string>
    <string name="auth_email_code_label">மின்னஞ்சலில் வந்த குறியீடு</string>
    <string name="auth_reset_password_and_data">கடவுச்சொல்லையும் தரவையும் மீட்டமை</string>
    <string name="onboarding_welcome_title">எல்லா மாடல்களும்.\nஒரே இடத்தில்.</string>
    <string name="onboarding_welcome_body">Facet என்பது உங்கள் சொந்த OpenAI, Anthropic, Google மற்றும் பிற API கீகளுக்கான தனிப்பட்ட, ஓப்பன் சோர்ஸ் அரட்டை ஆப்ஸ்.</string>
    <string name="onboarding_keys_point_title">உங்கள் கீகள், உங்கள் கட்டணம்</string>
    <string name="onboarding_keys_point_body">வழங்குநர்களுக்கு நேரடியாகப் பணம் செலுத்தலாம். ஒவ்வொரு பதிலின் செலவையும் பார்க்கலாம்.</string>
    <string name="onboarding_encrypted_point_title">எண்ட்-டு-எண்ட் என்க்ரிப்ஷன்</string>
    <string name="onboarding_encrypted_point_body">அரட்டைகளும் கீகளும் ஒத்திசைக்கப்படுவதற்கு முன் உங்கள் சாதனத்திலேயே பூட்டப்படுகின்றன.</string>
    <string name="onboarding_control_point_title">முழுக் கட்டுப்பாடு</string>
    <string name="onboarding_control_point_body">சிந்தனை முயற்சி, இணையத் தேடல், வழங்குநர் தரும் ஒவ்வொரு மாடலும்.</string>
    <string name="onboarding_get_started">தொடங்கு</string>
    <string name="onboarding_sync_title">தனிப்பட்ட முறையில் ஒத்திசைவு</string>
    <string name="onboarding_sync_body">இலவசக் கணக்கு உங்கள் அரட்டைகள், அசிஸ்டண்ட்கள், கீகளை உங்கள் ஃபோன், டேப்லெட், எதிர்காலச் சாதனங்கள் முழுவதும் ஒத்திசைவில் வைத்திருக்கும். அனைத்தும் உங்களிடம் மட்டுமே உள்ள கீயால் என்க்ரிப்ட் செய்யப்படுகின்றன.</string>
    <string name="onboarding_create_account">கணக்கை உருவாக்கு</string>
    <string name="onboarding_have_account">என்னிடம் ஏற்கெனவே கணக்கு உள்ளது</string>
    <string name="onboarding_skip_account">கணக்கு இல்லாமல் பயன்படுத்து</string>
    <string name="onboarding_skip_account_note">கணக்கு இல்லாமல், அனைத்தும் இந்தச் சாதனத்திலேயே இருக்கும். பிறகு அமைப்புகளில் கணக்கை உருவாக்கலாம்.</string>
