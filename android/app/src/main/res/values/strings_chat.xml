    <string name="chat_settings">Chat settings</string>
    <!-- Menu item: exports the chat as a Markdown document and shares it -->
    <string name="chat_share_markdown">Share as Markdown</string>
    <!-- Content description of the round button that scrolls to the latest message -->
    <string name="chat_scroll_to_bottom">Scroll to bottom</string>

