<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chat screen: top bar -->
    <!-- Content description of the button that opens the list of chats -->
    <string name="chat_open_chats">Open chats</string>
    <!-- Top bar title when no model is selected; tapping it opens the model list -->
    <string name="chat_choose_model">Choose a model</string>
