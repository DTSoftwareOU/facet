    <string name="settings_protection_title">How Facet protects your data</string>
    <string name="settings_protection_direct">Messages go straight from this device to the provider you choose. Facet\'s servers never see them.</string>
    <string name="settings_protection_encrypted">Synced chats, files, assistants and API keys are encrypted on your device with a key only you hold. The sync server stores ciphertext it can\'t read.</string>
    <string name="settings_protection_password">Your password never leaves the device. It\'s turned into a login key and an encryption key here.</string>
    <string name="settings_protection_keystore">API keys are also sealed with a hardware-backed key in Android\'s keystore.</string>
    <string name="settings_protection_no_tracking">No ads, no analytics, no tracking.</string>

