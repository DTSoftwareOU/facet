        <item quantity="other">Last clean-up, just now: cleared %1$d old files (%2$s) from sync storage.</item>
    </plurals>
    <!-- %1$d: number of files, %2$s: their total size (e.g. "14.2 MB"), %3$s: a relative time such as "5 min. ago", or a short date -->
