    <!-- Settings > Web search -->
    <string name="tools_web_search_title">Web search</string>
    <string name="tools_web_search_intro">Claude, GPT and Gemini models can search on their own. For every other model, add a search key here and Facet gives the model a search tool and a page reader. Searches go straight from your phone to the service you pick.</string>
