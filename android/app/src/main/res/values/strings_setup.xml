    <string name="tools_web_search_switch">Switch service</string>
    <string name="tools_web_search_prefer_native">Prefer built-in search</string>
    <string name="tools_web_search_prefer_native_subtitle">When a model can search on its own, let it. Turn off to always use your search service.</string>
    <string name="tools_web_search_remove_title">Remove web search?</string>
    <string name="tools_web_search_remove_body">Models without built-in search won\'t be able to search the web.</string>

