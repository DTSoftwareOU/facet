    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Every model.\nOne home.</string>
    <string name="onboarding_welcome_body">Facet is a private, open-source chat app for your own OpenAI, Anthropic, Google and other API keys.</string>
    <string name="onboarding_keys_point_title">Your keys, your bill</string>
    <string name="onboarding_keys_point_body">Pay providers directly. See the cost of every reply.</string>
    <string name="onboarding_encrypted_point_title">Encrypted end to end</string>
    <string name="onboarding_encrypted_point_body">Chats and keys are locked on your device before they sync.</string>
    <string name="onboarding_control_point_title">Full control</string>
    <string name="onboarding_control_point_body">Reasoning effort, web search, and every model a provider offers.</string>
    <!-- Button -->
    <string name="onboarding_get_started">Get started</string>
    <!-- Screen title -->
    <string name="onboarding_sync_title">Sync, privately</string>
    <string name="onboarding_sync_body">A free account keeps your chats, assistants and keys in step across your phone, tablet and future devices. Everything is encrypted with a key only you hold.</string>
    <!-- Button -->
    <string name="onboarding_create_account">Create an account</string>
    <!-- Button -->
    <string name="onboarding_have_account">I already have an account</string>
    <!-- Button -->
    <string name="onboarding_skip_account">Use without an account</string>
    <string name="onboarding_skip_account_note">Without an account, everything stays on this device. You can create one later in Settings.</string>
