<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so local model servers (Ollama, LM Studio) on your own network work.
     Facet's sync server and all cloud providers use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
