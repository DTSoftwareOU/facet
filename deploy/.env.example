# ---- Facet production settings --------------------------------------------
# Copy to deploy/.env and fill in. Never commit the real .env.

# Public hostname (needs a DNS A/AAAA record pointing at this server).
FACET_DOMAIN=facet.dtsoftware.io
# Required secrets, at least 32 characters each. Generate each one with:
#   openssl rand -base64 48
# Changing JWT_SECRET signs everyone out (they sign back in; no data is lost).
# Changing SERVER_SECRET changes the fake salts returned for unknown emails (harmless).
JWT_SECRET=
SERVER_SECRET=

# Accept new sign-ups.
REGISTRATION_OPEN=true

# Per-user storage for encrypted attachments, in bytes (2 GiB).
BLOB_QUOTA_BYTES=2147483648

LOG_LEVEL=info

# Optional SMTP: enables "reset by email" (which wipes encrypted data).
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
SMTP_FROM=Facet <no-reply@dtsoftware.io>
