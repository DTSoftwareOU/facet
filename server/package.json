{
  "name": "facet-sync-server",
  "version": "1.2.0",
  "description": "Zero-knowledge sync server for Facet",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vectors": "tsx scripts/gen-test-vectors.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
