# Local development settings (copy to .env). Generate secrets with: openssl rand -base64 48
JWT_SECRET=change-me-dev-jwt-secret-at-least-32-characters
SERVER_SECRET=change-me-dev-server-secret-at-least-32-characters
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_URL=http://localhost:8787
REGISTRATION_OPEN=true
LOG_LEVEL=info
